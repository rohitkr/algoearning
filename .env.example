# Copy to .env for local development. Never commit .env.
APP_ENV=development
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
# Where the Next.js server reaches the API
API_URL=http://localhost:8000
# Local database + cache (`make db-up`, or `make up` with Docker)
DATABASE_URL=postgresql://algoearning:algoearning@localhost:5432/algoearning
REDIS_URL=redis://localhost:6379/0
# Phase-3 stand-in for sign-in: the web/API accept an `X-Dev-User: you@example.com` header.
# Only allowed in development/test (the API refuses to start otherwise). Replaced by Clerk in phase 4.
DEV_AUTH=true

# Clerk (sign-in). Dashboard -> API keys. The API verifies session tokens with the instance's public keys.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Dashboard -> Webhooks -> endpoint https://<your-api>/v1/webhooks/clerk (user.created/updated/deleted) -> Signing secret
CLERK_WEBHOOK_SECRET=

# Razorpay (payments). Dashboard -> Account & Settings -> API Keys. Use TEST keys until the account is activated.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> https://<your-api>/v1/webhooks/razorpay (payment.captured, payment.failed, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# Master key for broker credentials: base64 of 32 random bytes. scripts/dev.sh creates one on first run.
# Losing it makes stored broker keys unreadable (users re-enter them); never commit it.
APP_ENCRYPTION_KEY=
# How browsers and brokers reach this API: the broker login callback is <API_PUBLIC_URL>/v1/brokers/<broker>/callback
API_PUBLIC_URL=http://127.0.0.1:8000
