# Copy to .env for local development. Never commit .env.
APP_ENV=development
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
# Where the Next.js server reaches the API
API_URL=http://localhost:8000
# Local database + cache (`make db-up`, or `make up` with Docker)
DATABASE_URL=postgresql://algoearning:algoearning@localhost:5432/algoearning
REDIS_URL=redis://localhost:6379/0
# Phase-3 stand-in for sign-in: the web/API accept an `X-Dev-User: you@example.com` header.
# Only allowed in development/test (the API refuses to start otherwise). Replaced by Clerk in phase 4.
DEV_AUTH=true

# Clerk (sign-in). Dashboard -> API keys. The API verifies session tokens with the instance's public keys.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Dashboard -> Webhooks -> endpoint https://<your-api>/v1/webhooks/clerk (user.created/updated/deleted) -> Signing secret
CLERK_WEBHOOK_SECRET=

# Razorpay (payments). Dashboard -> Account & Settings -> API Keys. Use TEST keys until the account is activated.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> https://<your-api>/v1/webhooks/razorpay (payment.captured, payment.failed, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# Master key for broker credentials: base64 of 32 random bytes. scripts/dev.sh creates one on first run.
# Losing it makes stored broker keys unreadable (users re-enter them); never commit it.
APP_ENCRYPTION_KEY=
# How browsers and brokers reach this API: the broker login callback is <API_PUBLIC_URL>/v1/brokers/<broker>/callback
API_PUBLIC_URL=http://127.0.0.1:8000

# Market data (phase 10): ONE platform feed from ICICI Breeze (https://api.icicidirect.com/apiuser/home).
# Leave empty to run the SIMULATED feed (random prices, development only). An admin logs in to Breeze once a
# trading day from Monitor > Market data. Set the Breeze app's redirect URL to the web app's address (http://localhost:3000): the app picks up ?apisession=
BREEZE_API_KEY=
BREEZE_API_SECRET=
# breeze | simulated | auto (breeze when the keys above are set)
MARKET_DATA_SOURCE=auto

# Notifications (phase 12). Email: any SMTP server (Gmail: smtp.gmail.com:587 + an app password). Leave SMTP_HOST
# empty to switch email off. Telegram: create a bot with @BotFather, put its token and username here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AlgoEarning <alerts@example.com>
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
