{
  "name": "algoearning",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "scripts/dev.sh",
    "dev:web": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "host:setup": "scripts/home-host.sh setup",
    "host:tunnel": "scripts/home-host.sh tunnel",
    "host:build": "scripts/home-host.sh build",
    "host:install": "scripts/home-host.sh install",
    "host:deploy": "scripts/home-host.sh deploy",
    "host:status": "scripts/home-host.sh status",
    "host:start": "scripts/home-host.sh start",
    "host:stop": "scripts/home-host.sh stop",
    "host:restart": "scripts/home-host.sh restart",
    "host:logs": "scripts/home-host.sh logs",
    "host:uninstall": "scripts/home-host.sh uninstall",
    "deploy": "scripts/home-host.sh deploy",
    "config:push": "scripts/config-backup.sh push",
    "config:list": "scripts/config-backup.sh list",
    "config:restore": "scripts/config-backup.sh restore",
    "db:backup": "uv run --env-file .env --with boto3 python scripts/backup.py push full",
    "db:backup:history": "uv run --env-file .env --with boto3 python scripts/backup.py push history",
    "db:backup:list": "uv run --env-file .env --with boto3 python scripts/backup.py list",
    "db:backup:pull": "uv run --env-file .env --with boto3 python scripts/backup.py pull",
    "db:restore": "uv run --env-file .env python scripts/backup.py restore",
    "history:show": "uv run --env-file .env python scripts/show-history.py",
    "history:backfill": "uv run --env-file .env python -m ae_worker backfill"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "~5.9.3"
  }
}
